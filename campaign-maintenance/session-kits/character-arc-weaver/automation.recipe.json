{
  "name": "D&D Character Arc Weaver",
  "prompt_file": ".github/session-kits/character-arc-weaver/automation.prompt.md",
  "settings": {
    "ownership": "user",
    "disabled": true,
    "require_actor_write_permission": true,
    "write_scope": "trigger",
    "tools": [
      "github/issue_read",
      "github/get_file_contents",
      "github/add_issue_comment"
    ],
    "triggers": {
      "issue_labeled": {
        "types": ["labeled"],
        "labels": ["character-arc-review"],
        "allow_copilot_triggers": false,
        "write_scope": "trigger"
      }
    }
  }
}
